[Unit]
Description=AMBER public website and verified Release mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=amber-sync
Group=amber-sync
UMask=0022
ExecStart=/usr/bin/python3 /usr/local/lib/amber-sync/amber_sync.py --config /etc/amber-sync/config.json run
TimeoutStartSec=28min
TimeoutStopSec=20s
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/amber-sync
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=2G
TasksMax=256
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amber-sync
# Node/V8 needs executable memory. User namespaces are needed by bubblewrap.
# Do not add MemoryDenyWriteExecute or disable Ubuntu's security protections.
