[Unit]
Description=AMBER isolated static website builder
Requires=amber-web-install.service
After=amber-web-install.service

[Service]
Type=oneshot
User=amber-build
Group=amber-build
UMask=0027
RootDirectory=/srv/amber-web-build-jail
MountAPIVFS=yes
PrivateNetwork=yes
BindReadOnlyPaths=/usr /opt/amber-web-tools:/tools /srv/amber-web-requests:/requests
BindPaths=/srv/amber-web-build:/build
ReadWritePaths=/build
WorkingDirectory=/build
ExecStart=/usr/bin/python3 /usr/local/lib/amber-sync/build_worker.py build
Environment=PATH=/tools/node/bin:/usr/bin:/bin
Environment=HOME=/build/home
TimeoutStartSec=10min
TimeoutStopSec=20s
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryMax=2G
TasksMax=256
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amber-web-build
